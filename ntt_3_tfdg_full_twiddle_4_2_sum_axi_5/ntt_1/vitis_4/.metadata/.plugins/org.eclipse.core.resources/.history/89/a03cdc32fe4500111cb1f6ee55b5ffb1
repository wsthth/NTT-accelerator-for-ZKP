#include "xil_printf.h"
#include "xil_io.h"
#include "xparameters.h"

#define NTT_BASE  XPAR_NTT_AXI_ACCELERATOR_0_S00_AXI_BASEADDR

// 寄存器偏移
#define REG_CTRL       0x00   // 写 start
#define REG_STATUS     0x04   // 读 done & result_valid
#define REG_CFG        0x08   // 写 radix_mode, width, parallelism
#define REG_MOD_LOW    0x0C   // 模数低32位
#define REG_MOD_MID    0x10   // 模数次低32位
#define REG_MOD_HIGH   0x14   // 模数次高32位
#define REG_MOD_TOP    0x18   // 模数最高32位
// N_prime 和 R2 类似，这里省略，可自行定义

// 输入数据基址（16 个点，每点 4 个 word）
#define INPUT_BASE     0x40   // 地址 16 (word) = 64 bytes
#define TWIDDLE_BASE   0x140  // 地址 80 (word) = 320 bytes
#define RESULT_BASE    0x1C0  // 地址 112 (word) = 448 bytes

// 辅助宏：写 128‑bit 数到指定基址 + 点索引
#define WRITE_128(base, point_idx, value_low, value_high) \
    Xil_Out32(NTT_BASE + (base) + (point_idx)*16 + 0, (value_low) & 0xFFFFFFFF); \
    Xil_Out32(NTT_BASE + (base) + (point_idx)*16 + 4, ((value_low) >> 32) & 0xFFFFFFFF); \
    Xil_Out32(NTT_BASE + (base) + (point_idx)*16 + 8, (value_high) & 0xFFFFFFFF); \
    Xil_Out32(NTT_BASE + (base) + (point_idx)*16 + 12, ((value_high) >> 32) & 0xFFFFFFFF)

// 读 128‑bit 结果
#define READ_128(base, point_idx, low_var, high_var) do { \
    low_var  = (u64)Xil_In32(NTT_BASE + (base) + (point_idx)*16 + 0); \
    low_var |= (u64)Xil_In32(NTT_BASE + (base) + (point_idx)*16 + 4) << 32; \
    high_var = (u64)Xil_In32(NTT_BASE + (base) + (point_idx)*16 + 8); \
    high_var |= (u64)Xil_In32(NTT_BASE + (base) + (point_idx)*16 + 12) << 32; \
} while(0)

int main() {
    xil_printf("NTT Accelerator Test\n");

    // 1. 配置 NTT 参数（示例：基2，256‑bit 模式，使用 1 个核）
    Xil_Out32(NTT_BASE + REG_CFG, (0 << 0) | (0 << 2) | (0 << 3));  // radix=2, width_384=0, parallelism=0

    // 2. 写模数 (128‑bit，此处示例值 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFB)
    Xil_Out32(NTT_BASE + REG_MOD_LOW,  0xFFFFFFFB);
    Xil_Out32(NTT_BASE + REG_MOD_MID,  0xFFFFFFFF);
    Xil_Out32(NTT_BASE + REG_MOD_HIGH, 0xFFFFFFFF);
    Xil_Out32(NTT_BASE + REG_MOD_TOP,  0xFFFFFFFF);

    // 3. 写 N' 和 R2 (必须根据实际模数计算，这里省略，假定已配置正确)
    // ...

    // 4. 写入输入数据（16 个点，每个 128‑bit）
    // 示例：点0 = 0x00000000000000000000000000000001
    WRITE_128(INPUT_BASE, 0, 0x1, 0x0);
    // 其他点可写 0
    for (int i = 1; i < 16; i++)
        WRITE_128(INPUT_BASE, i, 0x0, 0x0);

    // 5. 写入旋转因子（8 个，每个 128‑bit）
    // 示例：旋转因子0 = 0x1
    WRITE_128(TWIDDLE_BASE, 0, 0x1, 0x0);
    for (int i = 1; i < 8; i++)
        WRITE_128(TWIDDLE_BASE, i, 0x0, 0x0);

    // 6. 启动 NTT
    Xil_Out32(NTT_BASE + REG_CTRL, 0x1);

    // 7. 等待完成 (轮询状态寄存器 bit0)
    u32 status;
    do {
        status = Xil_In32(NTT_BASE + REG_STATUS);
    } while ((status & 0x1) == 0);

    xil_printf("NTT done, result_valid=%d\n", (status>>1)&1);

    // 8. 读取并打印结果 (16 个点)
    for (int i = 0; i < 16; i++) {
        u64 low, high;
        READ_128(RESULT_BASE, i, low, high);
        xil_printf("Result[%d] = 0x%016llx%016llx\n", i, high, low);
    }

    return 0;
}
