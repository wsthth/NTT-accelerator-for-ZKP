#include "xil_printf.h"
#include "xil_io.h"
#include "xparameters.h"

#define NTT_BASE  XPAR_NTT_AXI_ACCELERATOR_0_S00_AXI_BASEADDR

// 寄存器字节偏移
#define REG_CTRL       0x00   // 写 start (bit0)
#define REG_STATUS     0x04   // 读 done(bit0), result_valid(bit1)
#define REG_CFG        0x08   // 写 radix_mode[1:0], width_384_mode[2], parallelism[5:3]
#define REG_MOD_LOW    0x0C   // 模数低32位
#define REG_MOD_MID    0x10
#define REG_MOD_HIGH   0x14
#define REG_MOD_TOP    0x18

// 数据区基址（字节）
#define INPUT_BASE     0x40   // 对应 slv_reg[16]，16点 * 16字节 = 256字节
#define TWIDDLE_BASE   0x140  // 对应 slv_reg[80]，8个因子 * 16字节 = 128字节
#define RESULT_BASE    0x1C0  // 对应 slv_reg[112]，16点 * 16字节 = 256字节

// 写一个128位数到指定基址+点索引（小端，低64位在前）
static inline void write_128(u32 base, int idx, u64 low, u64 high) {
    u32 addr = NTT_BASE + base + idx * 16;
    Xil_Out32(addr,      (u32)(low));
    Xil_Out32(addr + 4,  (u32)(low >> 32));
    Xil_Out32(addr + 8,  (u32)(high));
    Xil_Out32(addr + 12, (u32)(high >> 32));
}

// 读一个128位数
static inline void read_128(u32 base, int idx, u64 *low, u64 *high) {
    u32 addr = NTT_BASE + base + idx * 16;
    u32 l0 = Xil_In32(addr);
    u32 l1 = Xil_In32(addr + 4);
    u32 h0 = Xil_In32(addr + 8);
    u32 h1 = Xil_In32(addr + 12);
    *low  = (u64)l0 | ((u64)l1 << 32);
    *high = (u64)h0 | ((u64)h1 << 32);
}

int main() {
    xil_printf("NTT Accelerator Test Start\n");

    // 1. 先测试 AXI 总线是否存活：写控制寄存器0x55，读回看是否一致
    Xil_Out32(NTT_BASE + REG_CTRL, 0x55);
    u32 test = Xil_In32(NTT_BASE + REG_CTRL);
    if (test == 0x55) {
        xil_printf("AXI bus OK (read back 0x%x)\n", test);
    } else {
        xil_printf("AXI bus ERROR! read 0x%x\n", test);
    }

    // 2. 配置 NTT 参数（基2，256-bit模式，1个核）
    Xil_Out32(NTT_BASE + REG_CFG, 0x00);  // radix=00, width=0, parallelism=000

    // 3. 写模数（示例：模数 = 2^128 - 1，实际需要根据你的NTT核心填入正确值）
    Xil_Out32(NTT_BASE + REG_MOD_LOW,  0xFFFFFFFF);
    Xil_Out32(NTT_BASE + REG_MOD_MID,  0xFFFFFFFF);
    Xil_Out32(NTT_BASE + REG_MOD_HIGH, 0xFFFFFFFF);
    Xil_Out32(NTT_BASE + REG_MOD_TOP,  0xFFFFFFFF);
    // 注意：N' 和 R2 也必须正确配置，这里省略（需根据模数计算）

    // 4. 写入输入数据（16个点，每个128-bit）
    //    示例：点0 = 1，其余为0
    write_128(INPUT_BASE, 0, 0x1, 0x0);
    for (int i = 1; i < 16; i++) {
        write_128(INPUT_BASE, i, 0x0, 0x0);
    }

    // 5. 写入旋转因子（8个，每个128-bit）
    //    示例：因子0 = 1，其余0
    write_128(TWIDDLE_BASE, 0, 0x1, 0x0);
    for (int i = 1; i < 8; i++) {
        write_128(TWIDDLE_BASE, i, 0x0, 0x0);
    }

    // 6. 启动 NTT
    xil_printf("Starting NTT...\n");
    Xil_Out32(NTT_BASE + REG_CTRL, 0x01);

    // 7. 等待完成（轮询状态寄存器 bit0）
    u32 status;
    do {
        status = Xil_In32(NTT_BASE + REG_STATUS);
    } while ((status & 0x01) == 0);

    xil_printf("NTT completed, status=0x%x (result_valid=%d)\n", status, (status>>1)&1);

    // 8. 读取并打印结果
    for (int i = 0; i < 16; i++) {
        u64 low, high;
        read_128(RESULT_BASE, i, &low, &high);
        xil_printf("Result[%2d] = 0x%016llx%016llx\n", i, high, low);
    }

    xil_printf("Test finished.\n");
    while(1);
    return 0;
}
