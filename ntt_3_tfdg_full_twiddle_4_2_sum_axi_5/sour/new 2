/*
 * 通用型分段蒙哥马利模乘Verilog（适配256/384bit模数）
 * 修复：移除always块内变量声明，解决Synth 8-1873综合错误
 */
module montgomery_generic #(
    // 参数配置：修改此处切换256/384bit
    parameter TOTAL_BITS    = 256,       // 总位宽：256/384
    parameter SEG_BITS      = 64,        // 分段位宽（固定64bit）
    parameter SEG_CNT       = TOTAL_BITS / SEG_BITS,  // 分段数：4/6
    // -------------------------- 256bit（P-256）常数（真实值） --------------------------
    parameter [TOTAL_BITS-1:0] M       = 256'hFFFFFFFF00000001000000000000000000000000FFFFFFFFFFFFFFFFFFFFFFFF,
    parameter [SEG_BITS-1:0]  M_PRIME  = 64'hFFFFFFFFFFFFFFFF,  // P-256的M'真实值
    parameter [TOTAL_BITS-1:0] R_INV   = 256'h000000000000000100000000000000000000000000000000000000000000005C,  // P-256的R_inv真实值
    // -------------------------- 384bit（P-384）常数（启用时注释256bit） --------------------------
    // parameter [TOTAL_BITS-1:0] M     = 384'hFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFC7634D81F4372DDF581A0DB248B0A77AECEC196ACCC52973,
    // parameter [SEG_BITS-1:0]  M_PRIME= 64'h0000000000000002,  // 示例值（替换为实际P-384的M'）
    // parameter [TOTAL_BITS-1:0] R_INV = 384'h00000000000000010000000000000000000000000000000000000000000000010000000000000000000000000000001,  // 示例值
    // ----------------------------------------------------------------------------------------------
    // parameter R             = (1 << SEG_BITS)  // R=2^64（基数）
    parameter R = (64'd1 << SEG_BITS);  // 64'd1是64位的1，左移64位后得到2^64（正确的R值）    
    
)(
    input  wire                     clk,          // 系统时钟（建议100MHz）
    input  wire                     rst_n,        // 低电平复位
    input  wire                     valid_in,     // 输入有效（仅1周期）
    input  wire [TOTAL_BITS-1:0]    A,            // 输入A（256/384bit）
    input  wire [TOTAL_BITS-1:0]    B,            // 输入B（256/384bit）
    output reg                      valid_out,    // 输出有效
    output reg [TOTAL_BITS-1:0]     mont_result   // 蒙哥马利结果：A×B×R⁻¹ mod M
);

// ===================== 1. 参数合法性校验（编译期） =====================
initial begin
    if (TOTAL_BITS != 256 && TOTAL_BITS != 384) begin
        $error("Error: TOTAL_BITS must be 256 or 384!");
        $finish;
    end
    if (TOTAL_BITS % SEG_BITS != 0) begin
        $error("Error: TOTAL_BITS must be integer multiple of SEG_BITS!");
        $finish;
    end
end

// ===================== 2. A/B缓存（解决valid_in与A/B同步更新的问题） =====================
reg [TOTAL_BITS-1:0] A_latch;  // 锁存A的值
reg [TOTAL_BITS-1:0] B_latch;  // 锁存B的值
reg valid_in_d1;               // valid_in延迟1周期

always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        A_latch <= {TOTAL_BITS{1'b0}};
        B_latch <= {TOTAL_BITS{1'b0}};
        valid_in_d1 <= 1'b0;
    end else begin
        if (valid_in) begin
            A_latch <= A;  // 锁存顶层输入的A/B
            B_latch <= B;
        end
        valid_in_d1 <= valid_in;  // 延迟1周期，避开时序冲突
    end
end

// ===================== 3. 分段拆分（基于锁存后的A/B，延迟1周期拆分） =====================
reg [SEG_BITS-1:0] A_seg [SEG_CNT-1:0];  // A分段：[SEG_CNT-1]（高位）~[0]（低位）
reg [SEG_BITS-1:0] B_seg [SEG_CNT-1:0];  // B分段：[SEG_CNT-1]（高位）~[0]（低位）
reg seg_valid;                           // 分段拆分完成有效信号

// 大端序拆分：基于延迟后的valid_in_d1触发
generate
    genvar seg_idx;
    for (seg_idx = 0; seg_idx < SEG_CNT; seg_idx = seg_idx + 1) begin : SEG_SPLIT
        always @(posedge clk or negedge rst_n) begin
            if (!rst_n) begin
                A_seg[seg_idx] <= {SEG_BITS{1'b0}};
                B_seg[seg_idx] <= {SEG_BITS{1'b0}};
            end else if (valid_in_d1) begin  // 延迟1周期后拆分
                A_seg[seg_idx] <= A_latch[(SEG_CNT-1-seg_idx)*SEG_BITS +: SEG_BITS];
                B_seg[seg_idx] <= B_latch[(SEG_CNT-1-seg_idx)*SEG_BITS +: SEG_BITS];
            end
        end
    end
endgenerate

// 分段拆分完成信号
always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        seg_valid <= 1'b0;
    end else begin
        seg_valid <= valid_in_d1;  // 拆分完成=延迟后的valid_in
    end
end

// ===================== 4. 并行部分积计算（基于拆分完成信号触发） =====================
reg [2*SEG_BITS-1:0] part_product [SEG_CNT-1:0];  // 64×64=128bit部分积
reg part_valid;                                    // 部分积有效信号

generate
    for (seg_idx = 0; seg_idx < SEG_CNT; seg_idx = seg_idx + 1) begin : PART_PROD
        always @(posedge clk or negedge rst_n) begin
            if (!rst_n) begin
                part_product[seg_idx] <= {2*SEG_BITS{1'b0}};
            end else if (seg_valid) begin  // 拆分完成后计算部分积
                part_product[seg_idx] <= A_seg[seg_idx] * B_seg[seg_idx];  // 并行乘法
            end
        end
    end
endgenerate

// 部分积有效信号
always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        part_valid <= 1'b0;
    end else begin
        part_valid <= seg_valid;  // 部分积有效=拆分完成
    end
end

// ===================== 5. 流水线模约简+递推（修复变量声明错误） =====================
reg [TOTAL_BITS-1:0] T [SEG_CNT-1:0];          // 流水线累加器
reg [SEG_BITS-1:0]   m [SEG_CNT-1:0];          // 每级约简因子m
reg [SEG_CNT-1:0]    pipe_valid;               // 流水线有效信号

// -------- 流水线第0级 --------
always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        T[0] <= {TOTAL_BITS{1'b0}};
        m[0] <= {SEG_BITS{1'b0}};
        pipe_valid[0] <= 1'b0;
    end else if (part_valid) begin
        T[0] <= part_product[0];  // 初始T[0]为0，直接赋值部分积
        m[0] <= (T[0][SEG_BITS-1:0] * M_PRIME) & {SEG_BITS{1'b1}};
        pipe_valid[0] <= 1'b1;
    end else begin
        pipe_valid[0] <= 1'b0;
    end
end

// -------- 流水线中间级（动态生成，移除块内变量声明） --------
generate
    for (seg_idx = 1; seg_idx < SEG_CNT-1; seg_idx = seg_idx + 1) begin : PIPE_MID
        // 临时变量移到generate块内、always块外（合法）
        reg [TOTAL_BITS-1:0] T_temp;
        
        always @(posedge clk or negedge rst_n) begin
            if (!rst_n) begin
                T[seg_idx] <= {TOTAL_BITS{1'b0}};
                m[seg_idx] <= {SEG_BITS{1'b0}};
                pipe_valid[seg_idx] <= 1'b0;
                T_temp <= {TOTAL_BITS{1'b0}};
            end else if (pipe_valid[seg_idx-1]) begin
                // 分步计算：先约简，再累加（避免同周期赋值覆盖）
                T_temp = (T[seg_idx-1] + (m[seg_idx-1] * M)) >> SEG_BITS;
                T_temp = T_temp + part_product[seg_idx];
                T[seg_idx] <= T_temp;
                // 计算当前段约简因子m
                m[seg_idx] <= (T_temp[SEG_BITS-1:0] * M_PRIME) & {SEG_BITS{1'b1}};
                pipe_valid[seg_idx] <= 1'b1;
            end else begin
                pipe_valid[seg_idx] <= 1'b0;
            end
        end
    end
endgenerate

// -------- 流水线最后一级（移除块内变量声明） --------
reg [TOTAL_BITS-1:0] T_final;
reg t_valid;
reg [TOTAL_BITS-1:0] T_temp_final;  // 临时变量移到always块外

always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        T_final <= {TOTAL_BITS{1'b0}};
        t_valid <= 1'b0;
        T_temp_final <= {TOTAL_BITS{1'b0}};
    end else if (SEG_CNT == 1 ? part_valid : pipe_valid[SEG_CNT-2]) begin
        // 最后一段约简
        if (SEG_CNT > 1) begin
            T_temp_final = (T[SEG_CNT-2] + (m[SEG_CNT-2] * M)) >> SEG_BITS;
        end else begin
            T_temp_final = T[0];
        end
        // 累加最后一段部分积
        T_temp_final = T_temp_final + part_product[SEG_CNT-1];
        // 归一化：确保T_final < M
        if (T_temp_final >= M) begin
            T_final <= T_temp_final - M;
        end else begin
            T_final <= T_temp_final;
        end
        t_valid <= 1'b1;
    end else begin
        t_valid <= 1'b0;
    end
end

// ===================== 6. 结果输出（修复大位宽%运算） =====================
reg [2*TOTAL_BITS-1:0] mul_temp;  // 临时存储大数乘法结果
reg mul_valid;

always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        mul_temp <= {2*TOTAL_BITS{1'b0}};
        mul_valid <= 1'b0;
    end else if (t_valid) begin
        mul_temp <= T_final * R_INV;  // 先计算乘法
        mul_valid <= 1'b1;
    end else begin
        mul_valid <= 1'b0;
    end
end

// 大数模M：通过减法实现（避免Verilog%对大位宽的支持问题）
always @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
        mont_result <= {TOTAL_BITS{1'b0}};
        valid_out   <= 1'b0;
    end else if (mul_valid) begin
        // P-256场景下，mul_temp < 2*M，只需一次比较减法
        if (mul_temp >= M) begin
            mont_result <= mul_temp - M;
        end else begin
            mont_result <= mul_temp;
        end
        valid_out   <= 1'b1;
    end else begin
        valid_out   <= 1'b0;
    end
end

endmodule

